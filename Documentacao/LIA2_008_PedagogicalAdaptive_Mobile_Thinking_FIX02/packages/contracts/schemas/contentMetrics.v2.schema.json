{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ContentMetrics.v2",
  "type": "object",
  "required": [
    "contractName",
    "available",
    "students",
    "materials",
    "documentPages",
    "textBlocks",
    "visualPendingBlocks",
    "embeddedChunks",
    "chunksPendingEmbedding",
    "processingJobs",
    "failedJobs",
    "learningGoals",
    "studySessions"
  ],
  "properties": {
    "contractName": {
      "const": "ContentMetrics.v2"
    },
    "available": {
      "type": "boolean"
    },
    "students": {
      "type": "integer",
      "minimum": 0
    },
    "materials": {
      "type": "integer",
      "minimum": 0
    },
    "documentPages": {
      "type": "integer",
      "minimum": 0
    },
    "textBlocks": {
      "type": "integer",
      "minimum": 0
    },
    "visualPendingBlocks": {
      "type": "integer",
      "minimum": 0
    },
    "embeddedChunks": {
      "type": "integer",
      "minimum": 0
    },
    "chunksPendingEmbedding": {
      "type": "integer",
      "minimum": 0
    },
    "processingJobs": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobs": {
      "type": "integer",
      "minimum": 0
    },
    "learningGoals": {
      "type": "integer",
      "minimum": 0
    },
    "studySessions": {
      "type": "integer",
      "minimum": 0
    },
    "errorType": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
