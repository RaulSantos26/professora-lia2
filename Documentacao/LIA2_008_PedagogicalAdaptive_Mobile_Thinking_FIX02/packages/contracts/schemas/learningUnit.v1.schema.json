{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LearningUnit.v1",
  "title": "LearningUnit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "learningUnitId",
    "learningContextSubjectId",
    "unitType",
    "code",
    "title",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractName": { "const": "LearningUnit.v1" },
    "learningUnitId": { "type": "string", "format": "uuid" },
    "learningContextSubjectId": { "type": "string", "format": "uuid" },
    "parentLearningUnitId": { "type": ["string", "null"], "format": "uuid" },
    "unitType": { "enum": ["LESSON", "MODULE", "CHAPTER", "SECTION"] },
    "code": { "type": "string", "minLength": 2, "maxLength": 100 },
    "title": { "type": "string", "minLength": 2, "maxLength": 250 },
    "description": { "type": ["string", "null"], "maxLength": 1500 },
    "displayOrder": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["DRAFT", "ACTIVE", "INACTIVE", "ARCHIVED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
