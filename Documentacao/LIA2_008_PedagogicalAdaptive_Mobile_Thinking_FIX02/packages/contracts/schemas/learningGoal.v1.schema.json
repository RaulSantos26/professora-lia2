{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LearningGoal.v1",
  "type": "object",
  "required": [
    "contractName",
    "learningGoalId",
    "studentId",
    "goalType",
    "title",
    "priority",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractName": {
      "const": "LearningGoal.v1"
    },
    "learningGoalId": {
      "type": "string",
      "format": "uuid"
    },
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "studentLearningContextId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "goalType": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "type": "string"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}