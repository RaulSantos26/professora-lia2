    "academicStageCount",
    "learningContextCount",
    "subjectCount",
    "learningUnitCount",
    "materialCount",
    "pedagogicalArtifactCount",
    "learningGoalCount",
    "studyScopeCount",
    "studySessionCount",
    "learningProgressCount"
  ],
  "properties": {
    "contractName": {
      "const": "WorkspaceSummary.v2"
    },
    "academicStageCount": {
      "type": "integer",
      "minimum": 0
    },
    "learningContextCount": {
      "type": "integer",
      "minimum": 0
    },
    "subjectCount": {
      "type": "integer",
      "minimum": 0
    },
    "learningUnitCount": {
      "type": "integer",
      "minimum": 0
    },
    "materialCount": {
      "type": "integer",
      "minimum": 0
    },
    "pedagogicalArtifactCount": {
      "type": "integer",
      "minimum": 0
    },
    "learningGoalCount": {
      "type": "integer",
      "minimum": 0
    },
    "studyScopeCount": {
      "type": "integer",
      "minimum": 0
    },
    "studySessionCount": {
      "type": "integer",
      "minimum": 0
    },
    "learningProgressCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
