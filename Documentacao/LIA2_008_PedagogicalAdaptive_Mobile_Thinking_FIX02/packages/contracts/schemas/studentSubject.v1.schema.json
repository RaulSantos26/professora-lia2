{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StudentSubject.v1",
  "title": "StudentSubject.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "studentSubjectId",
    "studentLearningContextId",
    "code",
    "name",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractName": { "const": "StudentSubject.v1" },
    "studentSubjectId": { "type": "string", "format": "uuid" },
    "studentLearningContextId": { "type": "string", "format": "uuid" },
    "subjectDefinitionId": { "type": ["string", "null"], "format": "uuid" },
    "code": { "type": "string", "minLength": 2, "maxLength": 100 },
    "name": { "type": "string", "minLength": 2, "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 1000 },
    "status": { "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
