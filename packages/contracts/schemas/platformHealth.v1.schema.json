{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PlatformHealth.v1",
  "title": "PlatformHealth.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "environment",
    "release",
    "overallStatus",
    "checkedAt",
    "services"
  ],
  "properties": {
    "contractName": {
      "const": "PlatformHealth.v1"
    },
    "environment": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "overallStatus": {
      "enum": ["ONLINE", "DEGRADED", "OFFLINE"]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "ServiceStatus.v1"
      }
    }
  }
}
